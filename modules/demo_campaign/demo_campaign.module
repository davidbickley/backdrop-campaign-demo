<?php
/**
 * @file
 * Organizing campaign pages, authorization cards and a School of Workers
 * approval workflow.
 *
 * Cards are saved locally first, then pushed to the CRM. If the CRM is down,
 * the card waits in a queue and cron retries it, so no signature is lost.
 */

/**
 * Implements hook_config_info().
 */
function demo_campaign_config_info() {
  $prefixes['demo_campaign.settings'] = array(
    'label' => t('Demo Campaign settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_autoload_info().
 */
function demo_campaign_autoload_info() {
  return array(
    'DemoCampaignOutboxMail' => 'demo_campaign.mail.inc',
  );
}

/**
 * Implements hook_permission().
 */
function demo_campaign_permission() {
  return array(
    'administer demo campaign' => array(
      'title' => t('Administer demo campaigns'),
      'description' => t('View cards, sign-ups, the outbox and the CRM log, and change settings.'),
      'restrict access' => TRUE,
    ),
  );
}

