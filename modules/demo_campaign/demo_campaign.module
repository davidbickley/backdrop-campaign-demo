  // Stands in for Salesforce's REST endpoint for creating a Lead.
  $items['crm-stub/services/data/v62.0/sobjects/Lead'] = array(
    'page callback' => 'demo_campaign_crm_stub',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'file' => 'demo_campaign.crm.inc',
  );

  // Staff dashboard.
  $items['admin/demo-campaign'] = array(
    'title' => 'Demo campaign',
    'description' => 'Authorization cards, School of Workers sign-ups, the outbox and the CRM log.',
    'page callback' => 'demo_campaign_admin_cards',
    'access arguments' => array('administer demo campaign'),
    'file' => 'demo_campaign.admin.inc',
  );
  $items['admin/demo-campaign/cards'] = array(
    'title' => 'Cards',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => 0,
  );
  $items['admin/demo-campaign/school'] = array(
    'title' => 'School sign-ups',
    'page callback' => 'demo_campaign_admin_school',
    'access arguments' => array('administer demo campaign'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 1,
    'file' => 'demo_campaign.admin.inc',
  );
  $items['admin/demo-campaign/outbox'] = array(
    'title' => 'Outbox',
    'page callback' => 'demo_campaign_admin_outbox',
    'access arguments' => array('administer demo campaign'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 2,
    'file' => 'demo_campaign.admin.inc',
  );
  $items['admin/demo-campaign/crm-log'] = array(
    'title' => 'CRM log',
    'page callback' => 'demo_campaign_admin_crm_log',
    'access arguments' => array('administer demo campaign'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 3,
    'file' => 'demo_campaign.admin.inc',
  );
  $items['admin/demo-campaign/settings'] = array(
    'title' => 'Settings',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('demo_campaign_settings_form'),
    'access arguments' => array('administer demo campaign'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 4,
